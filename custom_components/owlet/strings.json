{
  "config": {
    "step": {
      "user": {
        "data": {
          "region": "Region",
          "username": "Email",
          "password": "[%key:common::config_flow::data::password%]"
        },
        "data_description": {
          "region": "Pick Europe if your Owlet account was created in the EU or UK, otherwise pick World."
        }
      },
      "reauth_confirm": {
        "title": "Reauthentication required for Owlet",
        "data": {
          "password": "[%key:common::config_flow::data::password%]"
        },
        "description": "The Owlet login for {username} is no longer valid. Enter the password again."
      },
      "reconfigure": {
        "title": "Reconfigure Owlet",
        "description": "Change the region or log in again for {username}.",
        "data": {
          "region": "Region",
          "password": "[%key:common::config_flow::data::password%]"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_email": "Entered email address is incorrect",
      "invalid_password": "Entered password is incorrect",
      "invalid_credentials": "Entered credentials are incorrect",
      "unknown": "Unknown error occured",
      "no_devices": "No supported Owlet socks were found on this account"
    },
    "abort": {
      "already_configured": "Device already configured",
      "reauth_successful": "Reauthentication successful",
      "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Configure options for Owlet",
        "data": {
          "scan_interval": "Polling interval in seconds (minimum 5)",
